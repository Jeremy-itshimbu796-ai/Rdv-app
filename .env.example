NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Edge Function only; set with `supabase secrets set`.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
META_WHATSAPP_TOKEN=your-meta-permanent-access-token
META_WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
META_WHATSAPP_TEMPLATE_NAME=appointment_confirmation
SENTRY_DSN=

# Chariow, only used on the server and in its Pulse webhook.
CHARIOW_API_KEY=sk_live_...
CHARIOW_PRODUCT_ID=prd_...
CHARIOW_WEBHOOK_SECRET=whsec_...
